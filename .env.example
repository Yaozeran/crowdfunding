# Docker Compose configuration. Copy to .env in the repository root.
# Deploy sol/Crowdfund.sol first to enable wallet contributions.
CONTRACT_ADDRESS=
CHAIN_ID=11155111
RPC_URL=https://YOUR_SEPOLIA_RPC_ENDPOINT
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:5001
WEB_PORT=3000
API_PORT=5001

# Comma-separated wallet addresses permitted to moderate listings
ADMIN_WALLETS=
